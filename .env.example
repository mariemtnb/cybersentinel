# Copy to .env and fill in. .env is git-ignored: never commit real values.

# --- Data sources ---------------------------------------------------------------------
# NVD API key (free: https://nvd.nist.gov/developers/request-an-api-key). Optional: without it
# the pipeline runs in reduced-rate mode (one request every 6 s instead of 0.6 s).
NVD_API_KEY=
# Days of NVD modifications loaded on the very first run (later runs are incremental).
NVD_BACKFILL_DAYS=7

# --- Alerts -----------------------------------------------------------------------------
# Optional incoming-webhook URL (Slack / Mattermost / Teams format {"text": ...}).
# Leave empty: alerts are still stored and shown in the dashboard, and written to the logs.
ALERT_WEBHOOK_URL=

# --- Local S3-compatible object store (docker compose only) ---------------------------
S3_ACCESS_KEY=cybersentinel
# Choose any local secret (8+ characters). It only protects the local object store.
S3_SECRET_KEY=
S3_BUCKET=cybersentinel-lake

# --- Scheduling -------------------------------------------------------------------------
# Daily at 06:00 UTC. RUN_ON_STARTUP=true also runs the pipeline once when the stack starts.
PIPELINE_CRON=0 6 * * *
RUN_ON_STARTUP=true
LOG_LEVEL=INFO
